# ============================================================
# .env.example — Extrator FBref Brasileirão
# ============================================================
# Copie este arquivo para .env e preencha com suas credenciais.
# NUNCA commite o arquivo .env no Git.

# ── Banco de Dados (Supabase) ───────────────────────────────
# Vá no painel do Supabase -> Settings -> Database -> Connection string -> URI
# Deve começar com postgresql://...
SUPABASE_DB_URL=postgres

# ── Configurações do Extrator ───────────────────────────────
# URL base do Brasileirão 2025 no FBref
FBREF_URL=https://fbref.com/en/comps/24/2025/2025-Serie-A-Stats

# Pausa entre requisições em segundos (mínimo recomendado: 6)
REQUEST_DELAY=8

# Temporada a ser extraída (usado como sufixo nas tabelas do banco)
TEMPORADA=2025
